<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!--
        Registry for Moqui AgentSkills.
        The skill file on disk remains the canonical body, while this entity stores
        the discoverable and indexable metadata needed by MCP, DataDocument, and Graph.
    -->
    <entity entity-name="AgentSkillRegister" package="moqui.agent" use="configuration" cache="true">
        <field name="agentSkillRegisterId" type="id" is-pk="true"/>
        <field name="skillId" type="id-long">
            <description>Stable skill identifier from SKILL.md frontmatter or derived from its component path.</description>
        </field>
        <field name="artifactName" type="text-medium"/>
        <field name="artifactTypeEnumId" type="id"/>
        <field name="artifactGroupId" type="id"/>
        <field name="skillTypeEnumId" type="id"/>
        <field name="domainName" type="text-medium"/>
        <field name="title" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="componentName" type="text-medium"/>
        <field name="skillLocation" type="text-medium"/>
        <field name="skillPath" type="text-medium"/>
        <field name="statusId" type="id"/>
        <field name="frontmatterJson" type="text-very-long"/>
        <field name="bodyText" type="text-very-long"/>
        <field name="searchText" type="text-very-long"/>
        <field name="contentHash" type="text-medium"/>
        <field name="lastIndexedDate" type="date-time"/>
        <index name="MCPASKILL_SKILLID" unique="true">
            <index-field name="skillId"/>
        </index>
        <index name="MCPASKILL_ARTIFACT">
            <index-field name="artifactName"/>
        </index>
        <index name="MCPASKILL_COMPONENT">
            <index-field name="componentName"/>
        </index>
        <index name="MCPASKILL_DOMAIN">
            <index-field name="domainName"/>
        </index>
        <index name="MCPASKILL_STATUS">
            <index-field name="statusId"/>
        </index>
        <relationship type="one" related="moqui.basic.Enumeration" short-alias="artifactTypeEnum">
            <key-map field-name="artifactTypeEnumId"/>
        </relationship>
        <relationship type="one" title="AgentSkillType" related="moqui.basic.Enumeration" short-alias="skillTypeEnum">
            <key-map field-name="skillTypeEnumId"/>
        </relationship>
        <relationship type="one" related="moqui.security.ArtifactGroup" short-alias="artifactGroup">
            <key-map field-name="artifactGroupId"/>
        </relationship>
        <relationship type="one" related="moqui.basic.StatusItem" short-alias="status">
            <key-map field-name="statusId"/>
        </relationship>
    </entity>
</entities>
