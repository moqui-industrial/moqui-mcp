<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="true" menu-title="LibreChat">

    <actions>
        <set field="librechatDirectUrl" value="http://localhost:3081/"/>
    </actions>

    <widgets>
        <render-mode>
            <text type="html,vuet,qvt"><![CDATA[
                <div style="padding:0 0 12px 0;">
                    <a href="${librechatDirectUrl}" target="_blank" rel="noopener">Sign in to Agent Chat</a>
                    <span style="padding:0 8px; color:#999;">|</span>
                    <a href="#agent-chat" onclick="document.getElementById('agent-chat-frame').src='${librechatDirectUrl}'; return false;">Load embedded Agent Chat</a>
                </div>
                <div style="width:100%; height:calc(100vh - 152px);">
                    <iframe
                        id="agent-chat-frame"
                        title="Agent Chat"
                        style="width:100%; height:100%; border:none; border-radius:8px; background:white;"
                        allow="clipboard-read; clipboard-write; microphone; camera">
                    </iframe>
                </div>
            ]]></text>
        </render-mode>
    </widgets>
</screen>
