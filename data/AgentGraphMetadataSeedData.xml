<entity-facade-xml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-facade-3.xsd" type="seed-initial">

    <moqui.basic.Enumeration enumId="PpGraphArtifact" enumTypeId="ParameterPurpose" description="Graph Artifact Metadata"/>

    <moqui.math.ParameterDef parameterDefId="AgGraphVertexTypeParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="graphVertexType" parameterName="Graph Vertex Type" description="Normalized artifact type stored for a graph vertex."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphSourceVertexIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="sourceVertexId" parameterName="Source Vertex Id" description="Original artifact vertex id before graph normalization."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphSourceEdgeIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="sourceEdgeId" parameterName="Source Edge Id" description="Original artifact edge id before graph normalization."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphSourceArtifactUriParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="sourceArtifactUri" parameterName="Source Artifact URI" description="Canonical URI of the source artifact."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphArtifactKindParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="artifactKind" parameterName="Artifact Kind" description="Artifact family such as screen, service, entity, or xml-action."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphScreenPathParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="screenPath" parameterName="Screen Path" description="Screen path associated with the artifact."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphServiceNameParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="serviceName" parameterName="Service Name" description="Fully qualified Moqui service name."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphServiceVerbParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="serviceVerb" parameterName="Service Verb" description="Service verb extracted from the service definition."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphServiceNounParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="serviceNoun" parameterName="Service Noun" description="Service noun extracted from the service definition."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphEntityNameParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="entityName" parameterName="Entity Name" description="Entity name referenced by the artifact."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphFieldNameParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="fieldName" parameterName="Field Name" description="Entity field referenced by the artifact."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphDocumentTypeParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="documentType" parameterName="Document Type" description="Document family produced from the artifact."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphXmlActionElementParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="xmlActionElement" parameterName="XML Action Element" description="Element name from xml-actions-3.xsd, such as service-call or entity-find."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphStatementClassParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="statementClass" parameterName="Statement Class" description="Normalized semantic class for an xml-actions statement such as service_call, entity_read, or control_flow."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphGrammarAttributesParam" parameterTypeEnumId="PtTextLong" purposeEnumId="PpGraphArtifact" parameterCode="grammarAttributes" parameterName="Grammar Attributes" description="Comma-separated attribute names declared for an xml-actions XSD element."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphGrammarChildrenParam" parameterTypeEnumId="PtTextLong" purposeEnumId="PpGraphArtifact" parameterCode="grammarChildren" parameterName="Grammar Children" description="Comma-separated child element names declared for an xml-actions XSD element."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphGrammarSubstitutionGroupParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="grammarSubstitutionGroup" parameterName="Grammar Substitution Group" description="Substitution group declared for an xml-actions XSD element."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphDomainObjectParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="domainObject" parameterName="Domain Object" description="Domain object or business family inferred for the artifact."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphSubjectParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="subject" parameterName="Subject" description="Subject extracted from the artifact semantics."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphOperationParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="operation" parameterName="Operation" description="Operation or effect inferred from the artifact semantics."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphCalledServiceParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="calledService" parameterName="Called Service" description="Service referenced by a service-call xml-action."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphParameterRoleParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="parameterRole" parameterName="Parameter Role" description="Service parameter role such as in-parameters or out-parameters."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphSecurityArtifactNameParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="securityArtifactName" parameterName="Security Artifact Name" description="Moqui artifact name used for ArtifactAuthz matching, such as a service name or component URI."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphSecurityArtifactTypeParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="securityArtifactTypeEnumId" parameterName="Security Artifact Type" description="Moqui ArtifactType enum used for ArtifactAuthz matching."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphArtifactGroupIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="artifactGroupId" parameterName="Artifact Group Id" description="ArtifactGroup identifier associated with security metadata."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphArtifactGroupDescriptionParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="artifactGroupDescription" parameterName="Artifact Group Description" description="Description attached to an ArtifactGroup or related security structure."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphArtifactAuthzIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="artifactAuthzId" parameterName="Artifact Authz Id" description="Stable identifier for an ArtifactAuthz record."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphUserGroupIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="userGroupId" parameterName="User Group Id" description="UserGroup associated with ArtifactAuthz or ArtifactTarpit metadata."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphAuthzTypeEnumIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="authzTypeEnumId" parameterName="Authz Type" description="Authorization decision type such as AUTHZT_ALLOW or AUTHZT_ALWAYS."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphAuthzActionEnumIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="authzActionEnumId" parameterName="Authz Action" description="Authorization action such as AUTHZA_VIEW or AUTHZA_ALL."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphAuthzServiceNameParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="authzServiceName" parameterName="Authz Service Name" description="Service name delegated to resolve ArtifactAuthz decisions."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphEntityFilterSetIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="entityFilterSetId" parameterName="Entity Filter Set Id" description="EntityFilterSet identifier attached to ArtifactAuthz security filters."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphEntityFilterIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="entityFilterId" parameterName="Entity Filter Id" description="EntityFilter identifier attached to an EntityFilterSet."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphComparisonEnumIdParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="comparisonEnumId" parameterName="Comparison Enum Id" description="Comparison operator used by an EntityFilter."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphApplyCondParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="applyCond" parameterName="Apply Condition" description="Conditional expression attached to ArtifactAuthzFilter or EntityFilterSet metadata."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphNameIsPatternParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="nameIsPattern" parameterName="Name Is Pattern" description="Indicates whether ArtifactGroupMember artifactName is a regex pattern."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphInheritAuthzParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="inheritAuthz" parameterName="Inherit Authz" description="ArtifactGroupMember inheritAuthz flag."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphFilterMapParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="filterMap" parameterName="Filter Map" description="Groovy filter map expression from ArtifactGroupMember or EntityFilter metadata."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphAllowMissingAliasParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="allowMissingAlias" parameterName="Allow Missing Alias" description="EntityFilterSet allowMissingAlias flag."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphJoinOrParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="joinOr" parameterName="Join Or" description="EntityFilter joinOr flag."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphMaxHitsCountParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="maxHitsCount" parameterName="Max Hits Count" description="ArtifactTarpit max hits threshold."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphMaxHitsDurationParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="maxHitsDuration" parameterName="Max Hits Duration" description="ArtifactTarpit duration window in seconds."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphTarpitDurationParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="tarpitDuration" parameterName="Tarpit Duration" description="ArtifactTarpit lock duration in seconds."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphEdgeRelationParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="edgeRelation" parameterName="Edge Relation" description="Canonical relation label stored for a graph edge."/>
    <moqui.math.ParameterDef parameterDefId="AgGraphEdgeRoleParam" parameterTypeEnumId="PtTextShort" purposeEnumId="PpGraphArtifact" parameterCode="edgeRole" parameterName="Edge Role" description="Additional role information stored for a graph edge."/>

</entity-facade-xml>
