<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="mcp" noun="Handle" authenticate="true" allow-remote="true" transaction-timeout="300">
        <description>Generic MCP entrypoint for JSON-RPC requests. Dispatches core MCP protocol methods through McpClient.</description>
        <in-parameters>
            <parameter name="method" required="true"/>
            <parameter name="params" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="result" type="Map"/>
        </out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).handle(method as String, params instanceof Map ? (Map) params : [:])
        ]]></script></actions>
    </service>

    <service verb="server" noun="Discover" authenticate="true" allow-remote="true">
        <description>Return MCP discovery metadata for the Moqui MCP server.</description>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).serverDiscover()
        ]]></script></actions>
    </service>

    <service verb="list" noun="Tools" authenticate="true" allow-remote="true">
        <description>List the built-in MCP tools exposed by this component.</description>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).listTools()
        ]]></script></actions>
    </service>

    <service verb="call" noun="Tool" authenticate="true" allow-remote="true" transaction-timeout="300">
        <description>Call a built-in MCP tool.</description>
        <in-parameters>
            <parameter name="name" required="true"/>
            <parameter name="arguments" type="Map"/>
        </in-parameters>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).callTool(name as String, arguments instanceof Map ? (Map) arguments : [:])
        ]]></script></actions>
    </service>

    <service verb="list" noun="Resources" authenticate="true" allow-remote="true">
        <description>List Moqui entity and DataDocument resources addressable through MCP.</description>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).handle('resources/list', [:])
        ]]></script></actions>
    </service>

    <service verb="list" noun="ResourceTemplates" authenticate="true" allow-remote="true">
        <description>List Moqui MCP resource templates.</description>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).handle('resources/templates/list', [:])
        ]]></script></actions>
    </service>

    <service verb="read" noun="Resource" authenticate="true" allow-remote="true">
        <description>Read a single Moqui MCP resource by URI.</description>
        <in-parameters>
            <parameter name="uri" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).handle('resources/read', [uri: uri])
        ]]></script></actions>
    </service>

    <service verb="list" noun="Prompts" authenticate="true" allow-remote="true">
        <description>List MCP prompts backed by Moqui Wiki pages.</description>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).handle('prompts/list', [:])
        ]]></script></actions>
    </service>

    <service verb="get" noun="Prompt" authenticate="true" allow-remote="true">
        <description>Get a single MCP prompt by name from the configured Wiki space.</description>
        <in-parameters>
            <parameter name="name" required="true"/>
            <parameter name="arguments" type="Map"/>
        </in-parameters>
        <out-parameters><parameter name="result" type="Map"/></out-parameters>
        <actions><script><![CDATA[
            import org.moqui.mcp.McpClient
            result = new McpClient(ec).handle('prompts/get', [name: name, arguments: arguments instanceof Map ? (Map) arguments : [:]])
        ]]></script></actions>
    </service>
</services>
